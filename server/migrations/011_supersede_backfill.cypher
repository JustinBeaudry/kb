MATCH (c:ClaimRevision {status:'verified'}) WHERE coalesce(c.taskID,'')='' AND c.claimID IS NOT NULL AND c.projectID IS NOT NULL OPTIONAL MATCH (c)-[:VERIFIED_BY]->(v:Verification) WITH c, CASE WHEN v.data CONTAINS '"CheckedAt":"' THEN split(split(v.data,'"CheckedAt":"')[1],'"')[0] END AS raw WITH c, max(CASE WHEN raw =~ '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})' THEN datetime(raw) END) AS checked WITH c, checked, EXISTS { MATCH (:Claim {id:c.claimID})-[:HEAD]->(c) } AS head ORDER BY head DESC, checked IS NULL ASC, checked DESC, c.id DESC WITH c.claimID AS claim, c.projectID AS project, collect(c) AS revisions WHERE size(revisions) > 1 UNWIND revisions[1..] AS stale SET stale.status='superseded';
