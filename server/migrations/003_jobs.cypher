CREATE CONSTRAINT job_id IF NOT EXISTS FOR (j:Job) REQUIRE j.id IS UNIQUE;
CREATE CONSTRAINT job_key IF NOT EXISTS FOR (j:Job) REQUIRE j.key IS UNIQUE;
CREATE INDEX job_due IF NOT EXISTS FOR (j:Job) ON (j.status, j.dueAt);
CREATE CONSTRAINT job_effect_id IF NOT EXISTS FOR (e:JobEffect) REQUIRE e.id IS UNIQUE;
