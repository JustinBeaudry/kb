# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
FROM --platform=$BUILDPLATFORM golang:1.27.3-bookworm@sha256:d9b6a1beb9474adc2a1ce842573639b44b2a0dd49b6669f51d3821baf9ec37c9 AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' -o /out/kb-supervisor ./cmd/kb-supervisor && CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' -o /out/kb-admin ./cmd/kb-admin

FROM neo4j:2026.10.1-community@sha256:86f8e01402fd0d5fd23e8968375fefdc21284a5c1751fa3fa3de8091a08b6dd6
USER root
COPY --from=build /out/kb-supervisor /usr/local/bin/kb-supervisor
COPY --from=build /out/kb-admin /usr/local/bin/kb-admin
COPY deploy/graph-volume-init.sh /usr/local/bin/kb-graph-volume-init
COPY deploy/versions.json /opt/kb/versions.json
COPY scripts/Neo4jInitialPassword.java /opt/kb/Neo4jInitialPassword.java
RUN javac -cp "/var/lib/neo4j/lib/*" /opt/kb/Neo4jInitialPassword.java && rm /opt/kb/Neo4jInitialPassword.java
RUN mkdir -p /data/kb /run/kb && chown 7474:7474 /data /data/kb /run/kb && chmod 700 /data /data/kb /run/kb && chmod 755 /usr/local/bin/kb-graph-volume-init
ENV HOME=/var/lib/neo4j KB_SUPERVISOR_ROOT=/data/kb KB_SUPERVISOR_CONTROL_LISTEN=[::]:8091
COPY deploy/runtime-entrypoint.sh /usr/local/bin/kb-runtime-entrypoint
RUN chmod 755 /usr/local/bin/kb-runtime-entrypoint
USER 7474:7474
EXPOSE 7687 8091
STOPSIGNAL SIGTERM
# No public browser, no default image entrypoint. Supervisor owns Neo4j child.
ENTRYPOINT ["/usr/local/bin/kb-runtime-entrypoint", "/usr/local/bin/kb-supervisor"]
CMD ["serve"]
